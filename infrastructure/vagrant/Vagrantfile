require 'yaml'
require 'ipaddr'

puts "=================="
puts "This script will create a Vagrantfile for a RKE2 cluster"
puts "=================="

if File.exists?(File.join(File.dirname(__FILE__), "config.yaml")) then
  puts "Using configuration from config.yaml"
  x = YAML.load_file(File.join(File.dirname(__FILE__), 'config.yaml'))
else
  puts "Using default configurations"
  x = {
    'vagrant' => {
      'min_version' => '2.2.17',
      'cpus' => 2,
      'memory' => 4096,
      'box' => 'generic/rocky8',
    },
    'server' => {
      'count' => 1,
      'cpus' => 2,
      'memory' => 4096,
    },
    'worker' => {
      'count' => 2,
      'cpus' => 4,
      'memory' => 8192,
    },
    'network' => {
      'type' => 'private_network',
      'base_ip' => '10.42.0',
      'netmask' => '255.255.255.0',
      'cni' => 'calico',
      'private_nic_type' => '82545EM',
    },
  }
end
puts "Config: #{x.inspect}\n\n"


ENV['VAGRANT_I_KNOW_WHAT_IM_DOING_PLEASE_BE_QUIET'] = 'true'
ENV['VAGRANT_NO_PARALLEL'] = 'no'

Vagrant.require_version ">= 2.2.17"

$private_nic_type = x.fetch('network').fetch('private_nic_type')

$dns_script = <<-SCRIPT
  conn=$(nmcli -t -f NAME c show --active | head -n1)
  sudo nmcli con mod "${conn}" ipv4.dns "8.8.8.8 8.8.4.4"
SCRIPT

Vagrant.configure("2") do |config|
  # For user example 
  # config.vagrant.plugins = ["vagrant-reload", "vagrant-rke2"]
  # For dev work
  config.vagrant.plugins = ["vagrant-reload"]

  config.vm.provider "libvirt" do |v|
    v.cpus = x.fetch('vagrant').fetch('cpus')
    v.memory = x.fetch('vagrant').fetch('memory')
  end

  config.vm.provider "virtualbox" do |v|
    v.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
    v.cpus = x.fetch('vagrant').fetch('cpus')        
    v.memory = x.fetch('vagrant').fetch('memory')
    v.linked_clone = true
  end

  server_ip = "#{x['network']['base_ip']}.2"
  # define number of workers
  workers = x.fetch('workers').fetch('count')
  token = x.fetch('rke2').fetch('token')

  # define number of servers
  # if we want to make this a HA cluster, we can set this to 3 and use something like HAProxy
  servers = x.fetch('server').fetch('count')

  config.vm.define "server" do |server|
    server.vm.box = x.fetch('vagrant').fetch('box')
    server.vm.hostname = 'server'
    server.vm.network x.fetch('network').fetch('type'), ip: server_ip, netmask: x.fetch('network').fetch('netmask'), nic_type: $private_nic_type
    # generic/ubuntu2004 suffers from poor default dns servers, creates problems with hitting github.com immediately
    server.vm.provision "Set DNS", type: "shell", inline: $dns_script
    # perform network prequisites for eBPF
    server.vm.provision "Network Prerequisites", type: "shell", path: "./scripts/network.sh"

    # Kernel configuration for Cilium
    server.vm.provision "Kernel Configuration", type: "shell", path: "./scripts/kernel.sh"
    # reload
    server.vm.provision :reload
    # selinux configuration
    server.vm.provision "SELinux Configuration", type: "shell", path: "./scripts/selinux.sh"

    # firewall configuration
    server.vm.provision "Firewall Configuration", type: "shell", path: "./scripts/firewall.sh"
    server.vm.provision "Create Server Manifests Directory", type: "shell", inline: "sudo mkdir -p /var/lib/rancher/rke2/server/manifests"
    # upload file
    server.vm.provision "Upload Cilium Config", type: "file", source: "./files/rke2-cilium-helm-config.yaml", destination: "$HOME/rke2-cilium-helm-config.yaml"
    server.vm.provision "Upload Cilium values", type: "file", source: "./files/cilium-values.yaml", destination: "/tmp/cilium-values.yaml"
    # copy file to /var/lib/rancher/rke2/server/manifests/rke2-cilium-helm-config.yaml
    # server.vm.provision "Copy Cilium Config", type: "shell", inline: "sudo cp /tmp/rke2-cilium-helm-config.yaml /var/lib/rancher/rke2/server/manifests/rke2-cilium-helm-config.yaml"
    # install RKE2
    server.vm.provision "Install RKE2", type: "shell", inline: <<~SHELL
      sudo mkdir -p /etc/rancher/rke2
      cat <<-EOF > /etc/rancher/rke2/config.yaml
      write-kubeconfig-mode: '0644'
      selinux: false
      node-external-ip: #{server_ip}
      node-ip: #{server_ip}
      token: #{token}
      disable:
        - rke2-canal
        - rke2-kube-proxy
        - rke2-ingress-nginx
      disable-kube-proxy: true
      cni: #{x.fetch('network').fetch('cni')}
      network:
        plugin: none
EOF
    SHELL
    # install RKE2
    server.vm.provision :shell, :path => "./scripts/install_rke2.sh", :args => [server_ip, token, "server"]
    # install_cilium
    server.vm.provision :shell, :path => "./scripts/install_cilium.sh"
    # Configure Cilium
    server.vm.provision "Configure Cilium", type: "shell", inline: <<~SHELL
      cilium install -f "/tmp/cilium-values.yaml"
    SHELL
    # use cilium CLI to install cilium
    # server.vm.provision "Install Cilium", type: "shell", inline: <<~SHELL
    #   cilium install -f /tmp/cilium-values.yaml
    # SHELL
    # download K9s
    if x.fetch('k9s').fetch('install') == true
      server.vm.provision "Download K9s", type: "shell", inline: <<~SHELL
        # get K9s version from config, if not found default to v0.32.4
        K9S_VERSION=#{x.fetch('k9s').fetch('version')}
        # download RPM: https://github.com/derailed/k9s/releases/download/v0.32.4/k9s_linux_amd64.rpm
        curl -LO https://github.com/derailed/k9s/releases/download/v0.32.4/k9s_linux_amd64.rpm
        sudo rpm -i k9s_linux_amd64.rpm
        rm k9s_linux_amd64.rpm
      SHELL
    end
    if x.fetch('helm').fetch('install') == true
      server.vm.provision "Download Helm", type: "shell", inline: <<~SHELL
        # get Helm version from config, if not found default to v3.6.3
        HELM_VERSION=#{x.fetch('helm').fetch('version')}
        curl -fsSL -o get_helm.sh https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3
        chmod 700 get_helm.sh
        ./get_helm.sh
        rm get_helm.sh
      SHELL
    end
  end

  # iterate over the number of workers
  workers.times do |i|
    # generate the IP address for the worker by appending the worker number to the base IP
    node_ip = IPAddr.new("#{x['network']['base_ip']}.#{i+10}")
    ip = "#{x['network']['base_ip']}.#{i+10}"
    puts "Node IP: #{ip}"
    # define the worker
    # ip = x.fetch('network').fetch('base_ip')
    # node_ip = IPAddr.new("#x['network']['base_ip']}.#{i+10}")
    config.vm.define "worker-#{i+1}" do |worker|
      worker.vm.box = x.fetch('vagrant').fetch('box')
      worker.vm.hostname = "worker-#{i+1}"
      worker.vm.network x.fetch('network').fetch('type'), ip: IPAddr.new(node_ip.to_i, Socket::AF_INET).to_s, nic_type: $private_nic_type, netmask: x.fetch('network').fetch('netmask')
      # # set the DNS to 8.8.8.8
      # generic/ubuntu2004 suffers from poor default dns servers, creates problems with hitting github.com immediately
      worker.vm.provision "Set DNS", type: "shell", inline: $dns_script
          
      # perform network prequisites for eBPF. Run script at $HOME/scripts/network.sh
      worker.vm.provision "shell", path: "./scripts/network.sh"

      # Kernel configuration for Cilium. Run script at $HOME/scripts/kernel.sh
      worker.vm.provision "shell", path: "./scripts/kernel.sh"

      # reload
      worker.vm.provision :reload
      # selinux configuration. Run script at $HOME/scripts/selinux.sh
      worker.vm.provision "shell", path: "./scripts/selinux.sh"

      # firewall configuration
      worker.vm.provision "shell", path: "./scripts/firewall.sh"
      # storage configuration
      worker.vm.provision "shell", path: "./scripts/storage.sh"
      # install RKE2
      worker.vm.provision :shell, :path => "./scripts/install_rke2.sh", :args => [server_ip, token, "agent"]
    end
  end
end